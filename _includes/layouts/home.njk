---
layout: layouts/base.njk
pageName: index
pageScript: carousel
titleKey: meta.home.title
descriptionKey: meta.home.description
hero:
  image: https://images.unsplash.com/photo-1540104941499-a04da4661926?w=2000
  options:
    folder: hero
    widths: [400, 800, 1200, 1600, 2000]
    sizes: "(max-width: 800px) 800px, 100vw"
    class: hero-bg
    priority: true
skillImageSizes: "(min-width: 1011px) 20rem, (min-width: 760px) 31vw, (min-width: 560px) 47vw, 76vw"
---
{%- from "partials/contact-link.njk" import contactLink with context %}
  <main>
    <section class="hero">
      {% picture hero.image, "", hero.options %}
      <div class="hero-content">
        <h1><img src="{{ '/img/logo.svg' | asset_url }}" width="1411" height="216" alt="{{ 'hero.logo-alt' | translate }}"></h1>
        <p>{{ "hero.tagline" | translate }}</p>
        <a href="{{ '/fr/projects/' | locale_url }}" class="cta">{{ "hero.cta" | translate }}</a>
      </div>
    </section>

    <section id="about">
      <div class="wrapper">
        <h2>{{ "about.heading" | translate }}</h2>
        <p>{{ "about.intro" | translate }}</p>

        <ul>
          <li>{{ "about.bullet1" | translate | safe }}</li>
          <li>{{ "about.bullet2" | translate | safe }}</li>
          <li>{{ "about.bullet3" | translate | safe }}</li>
        </ul>

        <p>{{ "about.outro" | translate }}</p>
      </div>
    </section>

    <section id="house" aria-labelledby="house-heading">
      <h2 id="house-heading" class="visually-hidden">{{ "house.heading" | translate }}</h2>
      <div class="wrapper house-layout">
        <figure class="house-figure">
          <!-- Segments come from img/house.svg; the viewBox must match that file's -->
          <svg class="house" viewBox="126 -1 185 214" xmlns="http://www.w3.org/2000/svg">
            {%- for segment in range(1, 6) %}
            <use class="house-segment" data-segment="{{ segment }}" href="{{ ('/img/house.svg#house-segment-' + segment) | asset_url }}" />
            {%- endfor %}
          </svg>
        </figure>
        <!-- Texts are linked to their segment by data-segment only: each one can be moved anywhere on the page.
             .house-texts stacks them on top of each other -->
        <div class="house-texts">
          {%- for segment in range(1, 6) %}
          <article class="house-text" data-segment="{{ segment }}">
            <h3>{{ ("house.title" ~ segment) | translate }}</h3>
            <p>{{ ("house.text" ~ segment) | translate }}</p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section id="skills" aria-labelledby="skills-heading">
      <div class="wrapper">
        <h2 id="skills-heading">{{ "services.heading" | translate }}</h2>
        <!-- CSS-only carousel: swipe / scroll-snap everywhere, arrows and dots where ::scroll-button / ::scroll-marker are supported -->
        <ul class="skills-carousel" aria-label="{{ 'services.heading' | translate }}">
          {%- for skill in skills %}
          <li class="skill-slide">
            {% picture skill.image, ("skill." ~ skill.id ~ "-alt") | translate, { folder: "skills", widths: [400, 600, 800], ratio: [4, 3], sizes: skillImageSizes, lazy: true } %}
            <p>{% icon skill.icon %} <span>{{ ("skill." ~ skill.id) | translate }}</span></p>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <section id="contact">
      <div class="wrapper">
        <h2>{{ "contact.heading" | translate }}</h2>
        <address>
          <ul>
            <li>
              {{ contactLink(site.contact.email) }}
            </li>
            <li>
              {{ contactLink(site.contact.phone) }}
            </li>
            <li>
              {% icon "fa-map" %}
              <span>{{ "contact.location" | translate }}</span>
            </li>
            <li>
              {% icon "fa-building-columns" %}
              {{ site.contact.vat }}
            </li>
          </ul>
        </address>
      </div>
    </section>
  </main>

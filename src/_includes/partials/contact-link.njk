{#- Import with context, so the translate filter knows the page language:
    {% from "partials/contact-link.njk" import contactLink with context %} -#}

{#- One link to a site.contact channel (email, phone); showValue prints the address or number next to the icon,
    showLabel prints the labelKey text (e.g. "Appeler") before it.
    Visible text names the link, so screen readers announce it too; the icon alone gets the labelKey text -#}
{% macro contactLink(channel, showValue = true, showLabel = false) -%}
<a href="{{ channel.href }}"{% if not showValue and not showLabel %} aria-label="{{ channel.labelKey | translate }}"{% endif %}>
  {% icon channel.icon %}
  {%- if showLabel %}
  <span>{{ channel.labelKey | translate }}</span>
  {%- endif %}
  {%- if showValue %}
  <span>{{ channel.display }}</span>
  {%- endif %}
</a>
{%- endmacro %}

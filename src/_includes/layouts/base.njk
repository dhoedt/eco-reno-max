{%- from "partials/contact-link.njk" import contactLink with context -%}
<!DOCTYPE html>
<html lang="{{ page.lang }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ descriptionKey | translate }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ page.lang }}" href="{{ site.url }}{{ page.url }}">
  {%- for link in page.url | locale_links %}
  <link rel="alternate" hreflang="{{ link.lang }}" href="{{ site.url }}{{ link.url }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url | locale_url(site.defaultLanguage) }}">
  <link rel="icon" href="{{ '/img/favicon.svg' | asset_url }}" type="image/svg+xml">
  {%- if hero %}
  {% preloadPicture hero.image, hero.options %}
  {%- endif %}
  <!-- Same URLs as the @font-face rules of base.css, so the preloaded files are reused -->
  <link rel="preload" href="/fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/css/base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ ('/css/' + pageName + '.css') | asset_url }}">
  <title>{{ titleKey | translate }}</title>
</head>

<body>

  <header>
    <div class="wrapper">
      <nav>
        <a href="{{ '/fr/' | locale_url }}">EcoRéno Max</a>
        {%- if pageName == "index" %}
        <a class="cta" href="{{ '/fr/projects/' | locale_url }}">{{ "nav.projects" | translate }}</a>
        {%- endif %}
      </nav>
      <div id="navbar-right-side">
        <address>
          {{ contactLink(site.contact.email, false) }}
          {{ contactLink(site.contact.phone) }}
        </address>
        <!-- JS-free dropdown: <details> opens and closes the list natively -->
        <details class="lang-selector">
          {%- for language in site.languages %}
          {%- if language.code == page.lang %}
          <summary aria-label="{{ language.code | upper }} – {{ 'nav.language' | translate }}">
            <img src="{{ ('/img/flags/' + language.code + '.svg') | asset_url }}" width="24" height="16" alt="">
            <span>{{ language.code | upper }}</span>
            {% icon "fa-chevron-down" %}
          </summary>
          {%- endif %}
          {%- endfor %}
          <ul aria-label="{{ 'nav.language' | translate }}">
            {%- for language in site.languages %}
            <li>
              <a href="{{ page.url | locale_url(language.code) }}" hreflang="{{ language.code }}" lang="{{ language.code }}"
                aria-label="{{ language.code | upper }} – {{ language.name }}"{% if language.code == page.lang %} aria-current="page"{% endif %}>
                <img src="{{ ('/img/flags/' + language.code + '.svg') | asset_url }}" width="24" height="16" alt="">
                {{ language.code | upper }}
              </a>
            </li>
            {%- endfor %}
          </ul>
        </details>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <footer>
    <p><span>Made with lots of ♥ by</span> <a href="mailto:ask@dhoedt.com">Martin D'Hoedt</a></p>
  </footer>

  <script src="{{ ('/js/' + pageScript + '.js') | asset_url }}"></script>
</body>

</html>

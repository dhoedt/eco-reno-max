---
layout: layouts/base.njk
pageName: projects
pageScript: comparison
titleKey: meta.projects.title
descriptionKey: meta.projects.description
# name: unique project id; base name of the src/img/originals/<name>-before|after.jpg originals
# and of the project.<name>.* i18n keys; the "before" photo is always on the left
projects:
  - { name: living-room-floor }
  - { name: kitchen }
  - { name: bedroom-floor }
  - { name: kitchen-backsplash }
  - { name: stairs }
# number of projects at the top of the page whose images load eagerly; the following ones are lazy-loaded
eagerProjects: 3
# follows the breakpoints of css/base.css and css/projects.css: full wrapper (95vw), 60% of it (57vw), 60% of the capped wrapper (36rem)
imageSizes: "(min-width: 1011px) 36rem, (min-width: 760px) 57vw, 95vw"
---
<main>
    <section id="projects">
      <div class="wrapper">
        <h1>{{ "projects.heading" | translate }}</h1>
        {%- for project in projects %}
        {%- set key = "project." ~ project.name ~ "." %}
        {#- read before the inner loops shadow `loop` #}
        {%- set lazy = loop.index > eagerProjects %}
        {%- set states = ["before", "after"] %}
        <article class="project">
          <div class="comparison">
            {%- for slot in ["left", "right"] %}
            {%- set state = states[loop.index0] %}
            {% picture project.name ~ "-" ~ state ~ ".jpg", (key ~ state) | translate, { folder: "projects", ratio: [16, 9], class: "comparison-" ~ slot, sizes: imageSizes, lazy: lazy } %}
            {%- endfor %}
            <div class="comparison-handle" aria-hidden="true">
              <div class="comparison-handle-btn">&#8592; &#8594;</div>
            </div>
            {%- for slot in ["left", "right"] %}
            <span class="comparison-label comparison-label--{{ slot }}">{{ ("projects.label-" ~ states[loop.index0]) | translate }}</span>
            {%- endfor %}
            <input class="comparison-range" type="range" min="0" max="100" value="50"
              aria-label="{{ 'projects.compare' | translate }}">
          </div>
          <div class="project-body">
            <h2>{{ (key ~ "title") | translate }}</h2>
            <p>{{ (key ~ "desc") | translate }}</p>
          </div>
        </article>
        {%- endfor %}
      </div>
    </section>
  </main>

---
layout: layouts/base.njk
pageName: projects
pageScript: comparison
titleKey: meta.projects.title
descriptionKey: meta.projects.description
# image: base name of the src/img/originals/<image>-before|after.jpg originals; swapped: the "after" photo (and its label) sits on the left
projects:
  - { number: 1, image: floor, swapped: false, lazy: false }
  - { number: 2, image: stairs, swapped: true, lazy: false }
  - { number: 3, image: bedroom-floor, swapped: true, lazy: false }
  - { number: 4, image: kitchen, swapped: true, lazy: true }
  - { number: 5, image: living-room-floor, swapped: true, lazy: true }
  - { number: 6, image: kitchen-backsplash, swapped: true, lazy: true }
imageSizes: "(min-width: 1011px) 36rem, (min-width: 760px) 57vw, 95vw"
---
<main>
    <section id="projects">
      <div class="wrapper">
        <h1>{{ "projects.heading" | translate }}</h1>
        {%- for project in projects %}
        {%- set states = ["after", "before"] if project.swapped else ["before", "after"] %}
        <article class="project">
          <div class="comparison">
            {%- for slot in ["left", "right"] %}
            {%- set state = states[loop.index0] %}
            {% picture project.image ~ "-" ~ state ~ ".jpg", ("project" ~ project.number ~ "." ~ state) | translate, { folder: "projects", ratio: [16, 9], class: "comparison-" ~ slot, sizes: imageSizes, lazy: project.lazy } %}
            {%- endfor %}
            <div class="comparison-handle" aria-hidden="true">
              <div class="comparison-handle-btn">&#8592; &#8594;</div>
            </div>
            {#- Each label follows its photo, whichever side it is on #}
            {%- for slot in ["left", "right"] %}
            <span class="comparison-label comparison-label--{{ slot }}">{{ ("projects.label-" ~ states[loop.index0]) | translate }}</span>
            {%- endfor %}
            <input class="comparison-range" type="range" min="0" max="100" value="50"
              aria-label="{{ 'projects.compare' | translate }}">
          </div>
          <div class="project-body">
            <h2>{{ ("project" ~ project.number ~ ".title") | translate }}</h2>
            <p>{{ ("project" ~ project.number ~ ".desc") | translate }}</p>
          </div>
        </article>
        {%- endfor %}
      </div>
    </section>
  </main>
